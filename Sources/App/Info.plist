	<string>xCleaner quét tệp lớn và tệp trùng lặp trong thư mục này.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>xCleaner quét tệp lớn và tệp trùng lặp trong thư mục này.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>xCleaner quét các tệp tải về cũ trong thư mục này.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>xCleaner dọn Thùng rác trên các ổ đĩa gắn ngoài.</string>
